# Server Configuration
PORT=7000

# MongoDB Atlas Connection String
# Follow the MONGODB_ATLAS_SETUP.md guide to get your connection string
# Format: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/database_name?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/lightstorm_ecommerce?retryWrites=true&w=majority

# Google Gemini API Key (for AI product description generation)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret (for authentication - generate a random string)
JWT_SECRET=your_random_secret_key_here

# Node Environment
NODE_ENV=development
