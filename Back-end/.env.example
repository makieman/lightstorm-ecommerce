# Server Configuration
PORT=7000

# MongoDB Atlas Connection String
# Follow the MONGODB_ATLAS_SETUP.md guide to get your connection string
# Format: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/database_name?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/lightstorm_ecommerce?retryWrites=true&w=majority

# Google Gemini API Key (for AI product description generation)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret (for authentication - generate a random string)
JWT_SECRET=your_random_secret_key_here

# Node Environment
NODE_ENV=development

# Email service for verification (add your SMTP details)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (for CORS — set to your Vercel URL in production)
FRONTEND_URL=http://localhost:4200

# Application URL
APP_URL=http://localhost:4200
